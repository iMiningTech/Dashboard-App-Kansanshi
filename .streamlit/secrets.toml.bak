# Copy this to .streamlit/secrets.toml (gitignored) and fill in real values.
# In Streamlit Cloud, paste the same content into the app's Secrets settings.

[data]
source = "aws"        # "aws" = live pipeline; "csv" = legacy batch files
window_days = 7       # default rolling window the dashboard loads + amalgamates

[aws]
region = "us-east-1"
submissions_table = "orica-kansanshi-jotform-submissions-prod"
bucket = "orica-kansanshi-jotform-prod-432046692351"
access_key_id = "AKIA_REPLACE_ME"          # the read-only IAM user's key
secret_access_key = "REPLACE_ME"
